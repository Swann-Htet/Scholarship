# Copy this file to .env and fill it in. NEVER commit .env.
# MongoDB Atlas connection string (see README, step-by-step for beginners)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/globaldialogues?retryWrites=true&w=majority
# Admin login for /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-password
# Any long random string, used to sign admin login tokens
JWT_SECRET=change-this-to-a-long-random-string
# Email sending (for the 6-digit verification code and the ticket email). See README: "Email setup".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM=Global Dialogues <yourgmail@gmail.com>
# Local testing only: print the code in the terminal and show it on the page instead of sending an email.
# Ignored automatically on Vercel (production).
DEV_SHOW_OTP=1
# Local API port
PORT=5000
